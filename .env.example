# Supabase — required. Server uses the service-role key (server-only, never expose to client).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth secrets for protected routes.
# CRON_SECRET   — Vercel cron auth (Bearer) for GET /api/cron/fetch-x; also guards /api/health/detailed and POST /api/pins.
# INGEST_SECRET — collector auth (x-ingest-secret) for POST /api/ingest/source-batch; falls back to CRON_SECRET.
CRON_SECRET=
INGEST_SECRET=

# Reddit collector (free) — application-only OAuth for GET /api/cron/fetch-reddit.
# Create a "script" or "web app" at https://www.reddit.com/prefs/apps to get id/secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: comma-separated subreddits (default "vancouver") and a descriptive User-Agent.
REDDIT_SUBREDDITS=vancouver,britishcolumbia
REDDIT_USER_AGENT=web:recon-app:v1.0 (by /u/your-reddit-username)
